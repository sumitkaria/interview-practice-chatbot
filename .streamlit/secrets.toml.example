# Copy this into Streamlit Community Cloud → Settings → Secrets.
# Do not commit the filled-in file.

XAI_API_KEY = "xai-your-key"
# Optional. grok-4.7 is the current flagship and the app default.
GROK_MODEL = "grok-4.7"
# low keeps spoken-practice feedback quick. medium, high, and xhigh think longer.
GROK_REASONING_EFFORT = "low"

# Postgres connection string. Neon’s free database is enough.
# Without DATABASE_URL, Streamlit Cloud stores accounts in a file that is wiped on restart.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Signs the email/password session cookie. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET = "replace-with-a-long-random-string"

# Google sign-in. Create an OAuth client (Web application) in Google Cloud.
# Authorized redirect URI for the live app:
# https://interview-practice-chatbot-muenuogpm4k23s5gqqlabe.streamlit.app/oauth2callback
# Local testing also needs http://localhost:8501/oauth2callback
[auth]
redirect_uri = "https://interview-practice-chatbot-muenuogpm4k23s5gqqlabe.streamlit.app/oauth2callback"
cookie_secret = "replace-with-another-long-random-string"
client_id = "your-google-client-id"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
