# Copy this into Streamlit Community Cloud → Settings → Secrets.
# Do not commit the filled-in file.

ANTHROPIC_API_KEY = "sk-ant-your-key"
# Optional defaults. After sign-in, Model and Thinking in the left panel override these.
CLAUDE_MODEL = "claude-sonnet-5-5"
# low, medium, high, xhigh, or max.
CLAUDE_EFFORT = "low"

# Postgres connection string. Neon’s free database is enough.
# Without DATABASE_URL, Streamlit Cloud refuses to start, so accounts are not stored on a disk that is wiped.
# In Neon, click Connect and copy the pooled line. Its host contains -pooler.
# Paste that whole line between the quotes. Do not leave "..." in the value.
# Turn on backups in the Neon project. This app can download one account, not the whole database.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Defaults are 6 interviews and 160 interviewer replies per account per day.
MAX_INTERVIEWS_PER_DAY = "6"
MAX_MODEL_CALLS_PER_DAY = "160"

# Optional. Used in password-reset links and the About page. Set this when you add a custom domain.
PUBLIC_APP_URL = "https://interviewpractice.streamlit.app"

# Optional. Comma-separated emails that can see recent recorded problems.
ADMIN_EMAILS = ""

# Optional. Without these, password reset by email stays off. Signed-in people can still change a password.
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USER = "mailer"
# SMTP_PASSWORD = "replace-me"
# SMTP_FROM = "Interview Practice <practice@example.com>"

# Signs the email/password session cookie. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET = "replace-with-a-long-random-string"

# Google sign-in. Create an OAuth client (Web application) in Google Cloud.
# Authorized redirect URI for the live app:
# https://interviewpractice.streamlit.app/oauth2callback
# Local testing also needs http://localhost:8501/oauth2callback
[auth]
redirect_uri = "https://interviewpractice.streamlit.app/oauth2callback"
cookie_secret = "replace-with-another-long-random-string"
client_id = "your-google-client-id"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
